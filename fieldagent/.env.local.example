# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API key. Needs credits on the account:
# console.anthropic.com -> Plans & Billing
ANTHROPIC_API_KEY=

# Shared password for the three founders. Pick something long.
APP_PASSWORD=

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
