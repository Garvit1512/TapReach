# Copy to .env.local and fill in. Never commit .env.local.

# Which backend serves every command. Defaults to "openrouter" (free-tier
# testing, zero cost). Set to "grok" to use xAI instead — that costs real money.
LLM_PROVIDER=openrouter

# --- openrouter (default) ---
# Get a key at openrouter.ai -> Keys. No card required for :free models.
OPENROUTER_API_KEY=
# Must end in ":free" — the app refuses to run anything else, since OpenRouter
# bills non-free models at full price. Browse options at
# openrouter.ai/models?max_price=0. Leave blank to use the built-in default.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- grok (only used if LLM_PROVIDER=grok) ---
# console.x.ai -> API Keys. Real money — recon's web search runs through this.
XAI_API_KEY=

# Shared password for the three founders. Pick something long.
APP_PASSWORD=

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
